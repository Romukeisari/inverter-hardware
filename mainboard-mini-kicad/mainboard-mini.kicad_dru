(version 1)

# Hole-to-copper: JLCPCB needs 0.2 mm. Board Setup's minimum is set to 0.1 mm only so
# that J1 can be exempted below; this rule restores 0.2 mm for everything, zones included.
(rule "Hole to copper (JLCPCB)"
	(constraint hole_clearance (min 0.2mm)))

# J1 is a Tag-Connect TC2030 spring-pin footprint. Its NPTH holes take the plastic legs
# of the cable, so tracks and vias may sit closer than 0.2 mm. Keep 0.1 mm so anything
# really close still shows. Zones keep 0.2 mm from the rule above.
# Later rules take precedence, so this rule must stay below the general one.
(rule "J1 Tag-Connect alignment holes"
	(condition "(A.memberOfFootprint('J1') || B.memberOfFootprint('J1')) && A.Type != 'Zone' && B.Type != 'Zone'")
	(constraint hole_clearance (min 0.1mm)))
